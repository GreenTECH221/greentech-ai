{
  "hosting": {
    "target": "greentech-ai",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "redirects": [
      { "source": "/forkflex", "destination": "/rsa-x", "type": 301 },
      { "source": "/beyond", "destination": "/", "type": 301 }
    ],
    "headers": [
      {
        "source": "**/*.@(png|svg|jpg|webp)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      },
      {
        "source": "/_astro/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
